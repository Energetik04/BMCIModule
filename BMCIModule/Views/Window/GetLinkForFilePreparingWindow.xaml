<Window x:Class="BMCIModule.Views.Window.GetLinkForFilePreparingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BMCIModule.ViewModel"
             xmlns:local="clr-namespace:BMCIModule.Views.Window"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Title="{Binding Path=Title}">
    <Window.DataContext>
        <vm:GetLinkForFilePreparingVM></vm:GetLinkForFilePreparingVM>
    </Window.DataContext>
    <Grid>
        <ComboBox x:Name="rvtLinkList" HorizontalAlignment="Left" Margin="327,167,0,0" VerticalAlignment="Top" Width="120" ItemsSource="{Binding Links}"/>

    </Grid>
</Window>
