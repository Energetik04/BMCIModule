<Window x:Class="BMCIModule.SelectWorkset"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BMCIModule.ViewModel"
             xmlns:local="clr-namespace:BMCIModule"
        
             d:Height="350" d:Width="700" ResizeMode="NoResize"
             Title="{Binding Title}">
    <Window.DataContext>
        <vm:SelectWorksetViewModel/>
    </Window.DataContext>

    <Grid>
        
        <Grid.ColumnDefinitions>
         
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" Header="АСО">
            <ListBox ItemsSource="{Binding departmentCollection[0].ListMark}" DisplayMemberPath="Name"/>
            
        </GroupBox>   <!--реалиховать свойство по передаче тэга сюда -->
        <GroupBox Grid.Column="1" Header="АСУиС">
            <ListBox ItemsSource="{Binding departmentCollection[1].ListMark}" DisplayMemberPath="Name"/>
         </GroupBox>
        <GroupBox Grid.Column="2" Header="ОГПиТТ">
            <ListBox ItemsSource="{Binding departmentCollection[2].ListMark}" DisplayMemberPath="Name"/>
        </GroupBox>
        <GroupBox Grid.Column="3" Header="ОВиК">
            <ListBox ItemsSource="{Binding departmentCollection[3].ListMark}" DisplayMemberPath="Name"/>
        </GroupBox>
        <GroupBox Grid.Column="4" Header="ХТО">
            <ListBox ItemsSource="{Binding departmentCollection[4].ListMark}" DisplayMemberPath="Name"/>
        </GroupBox>
        <GroupBox Grid.Column="5" Header="ЭТО">
            <ListBox ItemsSource="{Binding departmentCollection[5].ListMark}" DisplayMemberPath="Name"/>
        </GroupBox>
        <GroupBox Grid.Column="6" Header="ОИИ">
            <ListBox ItemsSource="{Binding departmentCollection[6].ListMark}" DisplayMemberPath="Name"/>
        </GroupBox>
        <GroupBox Grid.Column="7" Header="ГО">
            <ListBox ItemsSource="{Binding departmentCollection[7].ListMark}" DisplayMemberPath="Name"/>
        </GroupBox>
    </Grid>
</Window>
