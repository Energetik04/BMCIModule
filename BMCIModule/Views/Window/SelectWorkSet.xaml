<Window x:Class="BMCIModule.SelectWorkset"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BMCIModule.ViewModel"
             xmlns:local="clr-namespace:BMCIModule"
        
             Height="220" Width="700" ResizeMode="NoResize"  
             Title="{Binding Title}">
    <!--<Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="SaveCmdExecuted"
                        CanExecute="SaveCmdCanExecuted"/>
    </Window.CommandBindings>-->
    <Window.DataContext>
        <vm:SelectWorksetViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="None"/>
        </Style>
    </Window.Resources>


    <StackPanel Orientation="Vertical"
                VerticalAlignment="Top"
                Width="Auto"
                Height="Auto">
        <Grid>
       <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" Header="АСО">
            <DataGrid ItemsSource="{Binding  departmentCollection[0].ListMark}"
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns >
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <!--реалиховать свойство по передаче тэга сюда -->
        <GroupBox Grid.Column="1" Header="АСУиС">
            <DataGrid ItemsSource="{Binding  departmentCollection[1].ListMark}" 
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns >
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Column="2" Header="ОГПиТТ">
            <DataGrid ItemsSource="{Binding  departmentCollection[2].ListMark}" 
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns >
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Column="3" Header="ОВиК">
            <DataGrid ItemsSource="{Binding  departmentCollection[3].ListMark}" 
                    Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns >
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Column="4" Header="ХТО">
            <DataGrid ItemsSource="{Binding  departmentCollection[4].ListMark}" 
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns >
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Column="5" Header="ЭТО">
            <DataGrid ItemsSource="{Binding  departmentCollection[5].ListMark}" 
                     Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns >
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Column="6" Header="ОИИ">
            <DataGrid ItemsSource="{Binding  departmentCollection[6].ListMark}" 
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns >
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Column="7" Header="ГО">
            <DataGrid ItemsSource="{Binding  departmentCollection[7].ListMark}" 
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
        <Grid Height="50">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="10">
                <Button Style="{StaticResource ButtonStyle}" 
                        Content="Сохранить"
                        Command="{Binding SavePresetWorksetToXMLCommand}"/>
                <Button Style="{StaticResource ButtonStyle}" 
                        Content="Открыть"/>
                <Button Style="{StaticResource ButtonStyle}" 
                        Content="Применить"
                        ClickMode="Press"/>
                <Button Style="{StaticResource ButtonStyle}"
                        Content="Закрыть"
                        Command="{Binding CloseAplicationCommand}"
                        >

                </Button>
            </StackPanel>

        </Grid>
    </StackPanel>
</Window>
