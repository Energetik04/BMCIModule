<Window x:Class="BMCIModule.SelectWorkset"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BMCIModule"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel x:Name="TitleWindow" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            
            <TextBox HorizontalAlignment="Center" FontSize="14" FontFamily="GOST Common">
                Выберите марки проектов для создания рабочих наборов
                </TextBox>
        </StackPanel>
        <StackPanel x:Name="ETO" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" >
            <ListBox x:Name="tagETOName" HorizontalAlignment="Left" Height="100" Width="63" FontSize="14"/>
        </StackPanel>
        

    </Grid>
</Window>
