<Window x:Class="BMCIModuleWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BMCIModuleWPF"
        
        mc:Ignorable="d"
        Title="MainWindow" Height="230" Width="700" ResizeMode="NoResize">
    <Window.DataContext>
        <local:Class1/>
    </Window.DataContext>
    <StackPanel Orientation="Vertical"
            VerticalAlignment="Top"
            Width="Auto"
            Height="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="АСО">
                <DataGrid ItemsSource="{Binding  departmentCollection[0].ListMark}"
                  AutoGenerateColumns="False"
                  HorizontalGridLinesBrush="Transparent"
                  VerticalGridLinesBrush="Transparent"
                  HeadersVisibility="None"
                  Background="White"
                  CanUserAddRows="False">
                    <DataGrid.Columns >
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <!--реалиховать свойство по передаче тэга сюда -->
            <GroupBox Grid.Column="1" Header="АСУиС">
                <DataGrid ItemsSource="{Binding  departmentCollection[1].ListMark}" 
                  AutoGenerateColumns="False"
                  HorizontalGridLinesBrush="Transparent"
                  VerticalGridLinesBrush="Transparent"
                  Background="White"
                  HeadersVisibility="None"
                  CanUserAddRows="False">
                    <DataGrid.Columns >
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="ОГПиТТ">
                <DataGrid ItemsSource="{Binding  departmentCollection[2].ListMark}" 
                  AutoGenerateColumns="False"
                  HorizontalGridLinesBrush="Transparent"
                  VerticalGridLinesBrush="Transparent"
                  Background="White"
                  HeadersVisibility="None"
                  CanUserAddRows="False">
                    <DataGrid.Columns >
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="3" Header="ОВиК">
                <DataGrid ItemsSource="{Binding  departmentCollection[3].ListMark}" 
                AutoGenerateColumns="False"
                HorizontalGridLinesBrush="Transparent"
                VerticalGridLinesBrush="Transparent"
                Background="White"
                HeadersVisibility="None"
                CanUserAddRows="False">
                    <DataGrid.Columns >
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="4" Header="ХТО">
                <DataGrid ItemsSource="{Binding  departmentCollection[4].ListMark}" 
                  AutoGenerateColumns="False"
                  HorizontalGridLinesBrush="Transparent"
                  VerticalGridLinesBrush="Transparent"
                  Background="White"
                  HeadersVisibility="None"
                  CanUserAddRows="False">
                    <DataGrid.Columns >
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="5" Header="ЭТО">
                <DataGrid ItemsSource="{Binding  departmentCollection[5].ListMark}" 
                  AutoGenerateColumns="False"
                  HorizontalGridLinesBrush="Transparent"
                  Background="White"
                  VerticalGridLinesBrush="Transparent"
                  HeadersVisibility="None"
                  CanUserAddRows="False">
                    <DataGrid.Columns >
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="6" Header="ОИИ">
                <DataGrid ItemsSource="{Binding  departmentCollection[6].ListMark}" 
                  AutoGenerateColumns="False"
                  HorizontalGridLinesBrush="Transparent"
                  VerticalGridLinesBrush="Transparent"
                  Background="White"
                  HeadersVisibility="None"
                  CanUserAddRows="False">
                    <DataGrid.Columns >
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="7" Header="ГО">
                <DataGrid ItemsSource="{Binding  departmentCollection[7].ListMark}" 
                  AutoGenerateColumns="False"
                  HorizontalGridLinesBrush="Transparent"
                  VerticalGridLinesBrush="Transparent"
                  Background="White"
                  HeadersVisibility="None"
                  CanUserAddRows="False">
                    <DataGrid.Columns >
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Binding="{Binding StatusMark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
        <Grid Height="50">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="10">
                <Button Width="65" 
                    Height="20" 
                    Margin="2" 
                    Content="Сохранить"/>
                <Button Width="65" 
                    Height="20" 
                    Margin="2" 
                    Content="Открыть"/>
                <Button Width="65" 
                    Height="20" 
                    Margin="2" 
                    Content="Применить"
                    ClickMode="Press"/>
                <Button Width="65" 
                    Height="20" 
                    Margin="2" 
                    Content="Закрыть"
                    Command="{Binding CloseAplicationCommand}"/>
            </StackPanel>

        </Grid>
    </StackPanel>
</Window>
